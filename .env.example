# TurkuCityTour — local development (copy to .env or .env.test)

# --- Client (safe to prefix with VITE_; bundled into the browser) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_THUNDERFOREST_API_KEY=your-thunderforest-key
VITE_IMAGE_BUCKET_NAME=your-storage-bucket

# Set to false for Capacitor / mobile store builds (excludes admin routes from bundle)
# VITE_ENABLE_ADMIN=false

# Set to true when building for Capacitor (uses HashRouter for deep links)
# VITE_MOBILE_BUILD=true

# --- Server / CI only — NEVER use VITE_ prefix for these ---
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used by integration tests and local scripts only:
# SUPABASE_TEST_URL=
# SUPABASE_TEST_ANON_KEY=
# SUPABASE_TEST_SERVICE_ROLE_KEY=
# SUPABASE_TEST_USER_EMAIL=
# SUPABASE_TEST_USER_PASSWORD=
# SUPABASE_TEST_ADMIN_EMAIL=
# SUPABASE_TEST_ADMIN_PASSWORD=

# --- Optional E2E live login ---
# E2E_TEST_USER_EMAIL=
# E2E_TEST_USER_PASSWORD=
