# Copy to .env.test for local integration tests.
# Do NOT prefix test secrets with VITE_ — they must not enter the client bundle.

SUPABASE_TEST_URL=https://your-project.supabase.co
SUPABASE_TEST_ANON_KEY=your-anon-key
SUPABASE_TEST_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_TEST_USER_EMAIL=player@example.com
SUPABASE_TEST_USER_PASSWORD=TestUserPass123!
SUPABASE_TEST_ADMIN_EMAIL=admin@example.com
SUPABASE_TEST_ADMIN_PASSWORD=AdminPass123!
